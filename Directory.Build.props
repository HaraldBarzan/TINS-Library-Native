<Project>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.1</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Default for the core RID/Desktop packages (OpenBLAS + PocketFFT, both BSD-3-Clause).
         The FFTW opt-in packages (pack/TINS.Native.FFTW.*) override this to GPL-2.0-or-later:
         FFTW itself is GPL-2.0-or-later, so a package containing only FFTW binaries must declare
         that, not this repo's own (more permissive) default. See CLAUDE.md decision on the
         FFTW/core package split for why these can no longer share one blanket license. -->
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HaraldBarzan/tins-lib-native</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HaraldBarzan/tins-lib-native</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <Authors>Harald Bârzan</Authors>
    <Company>Transylvanian Institute of Neuroscience</Company>
    <!-- Repo-relative, not a hardcoded personal path; matches the artifacts/nupkg convention
         CI already uses (ci.yml's own -o artifacts/nupkg overrides this anyway). Point
         PackageOutputPath at your own local feed via an environment/global override if you want
         `dotnet pack` to drop straight into one, instead of changing this shared default. -->
    <PackageOutputPath Condition="'$(PackageOutputPath)'==''">$(MSBuildThisFileDirectory)artifacts\nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)package-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
