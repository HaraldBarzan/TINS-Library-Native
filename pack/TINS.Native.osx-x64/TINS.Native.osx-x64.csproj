<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <PackageId>TINS.Native.osx-x64</PackageId>
    <Description>Native runtime assets (OpenBLAS) for TINS.Core on osx-x64, BSD-3-Clause throughout. For FFTW (GPL-2.0-or-later), add TINS.Native.FFTW.osx-x64 separately -- see that package's description for why it's a separate opt-in reference instead of bundled here.</Description>
    <PackageTags>Neuroscience, Native, OpenBLAS, osx-x64</PackageTags>
    <NativeStagingDir Condition="'$(NativeStagingDir)'==''">$(MSBuildThisFileDirectory)..\..\artifacts\runtimes\osx-x64\native</NativeStagingDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeStagingDir)\*" Pack="true"
          PackagePath="runtimes/osx-x64/native/%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <!-- BSD-3-Clause requires reproducing the copyright notice in redistributions: bundling the
       actual upstream license text (not just the PackageLicenseExpression metadata above) alongside
       the binaries it covers. See licenses/README.md for provenance/pinned-version notes. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\licenses\OpenBLAS-LICENSE.txt" Pack="true"
          PackagePath="licenses\OpenBLAS-LICENSE.txt" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\licenses\PocketFFT-LICENSE.md" Pack="true"
          PackagePath="licenses\PocketFFT-LICENSE.md" Visible="false" />
  </ItemGroup>

</Project>
