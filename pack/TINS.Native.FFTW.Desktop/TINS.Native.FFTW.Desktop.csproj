<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <PackageId>TINS.Native.FFTW.Desktop</PackageId>
    <!-- GPL-2.0-or-later, matching the RID packages this depends on; see CLAUDE.md's decision
         on the FFTW/core license split for why FFTW lives in its own opt-in family at all. -->
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <Description>Meta-package bundling TINS.Native.FFTW.win-x64, TINS.Native.FFTW.linux-x64, TINS.Native.FFTW.osx-x64, and TINS.Native.FFTW.osx-arm64, so a multi-platform consumer that has already decided to accept FFTW's GPL-2.0-or-later obligation can pull in FFTW for every built desktop RID with a single reference instead of adding each RID package individually. A single-RID deployment should still reference just its own TINS.Native.FFTW.&lt;rid&gt; package directly -- this carries no native content of its own.</Description>
    <PackageTags>Neuroscience, Native, FFTW, GPL, Desktop</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same floor-pinning rationale as TINS.Native.Desktop; see that project's own comment
         for the condensed history (full detail in CLAUDE.md's Decision 8/9), including the
         "Verify Desktop dependency floors are actually published" CI guard rail that now
         enforces this stays correct. osx-x64 re-added 2026-10-15 alongside the core package,
         once TINS.Native.FFTW.osx-x64 had a real build to reference. -->
    <PackageReference Include="TINS.Native.FFTW.win-x64" Version="1.1.0" />
    <PackageReference Include="TINS.Native.FFTW.linux-x64" Version="1.1.0" />
    <PackageReference Include="TINS.Native.FFTW.osx-x64" Version="1.1.0" />
    <PackageReference Include="TINS.Native.FFTW.osx-arm64" Version="1.1.0" />
  </ItemGroup>

</Project>
