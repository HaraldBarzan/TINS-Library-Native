<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <PackageId>TINS.Native.linux-x64</PackageId>
    <Description>Native runtime assets (OpenBLAS) for TINS.Core on linux-x64, BSD-3-Clause throughout. For FFTW (GPL-2.0-or-later), add TINS.Native.FFTW.linux-x64 separately -- see that package's description for why it's a separate opt-in reference instead of bundled here.</Description>
    <PackageTags>Neuroscience, Native, OpenBLAS, linux-x64</PackageTags>
    <NativeStagingDir Condition="'$(NativeStagingDir)'==''">$(MSBuildThisFileDirectory)..\..\artifacts\runtimes\linux-x64\native</NativeStagingDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeStagingDir)\*" Pack="true"
          PackagePath="runtimes/linux-x64/native/%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>
